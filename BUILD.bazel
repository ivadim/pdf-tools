exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "rustfmt.toml",
])

# Targets for cross-builds: `bazel build --platforms=//:linux_x86_64 ...`.
[platform(
    name = "linux_" + cpu,
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:" + cpu,
    ],
) for cpu in [
    "x86_64",
    "aarch64",
]]

# The web version's WebAssembly: `bazel build --platforms=//:wasm32_wasip1 ...`.
platform(
    name = "wasm32_wasip1",
    constraint_values = [
        "@platforms//os:wasi",
        "@platforms//cpu:wasm32",
    ],
)
