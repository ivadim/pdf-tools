"""PDF Tools, built with Bazel. Third-party crates come from Cargo.toml and Cargo.lock."""

module(name = "pdftools")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
# Xcode's toolchain and the iOS platforms, for the iOS app's engine.
bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_apple", version = "5.3.0")
bazel_dep(name = "rules_swift", version = "4.2.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "llvm", version = "0.8.24")
# The Android app (//android): Android and Kotlin rules, and a pinned SDK, NDK,
# emulator and system image that Bazel downloads, so nothing needs installing.
bazel_dep(name = "rules_android", version = "0.8.0")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "hermetic_android_toolchains", version = "0.5.0")
# rules_android's build tools are written in Go; its own Go 1.22 is too old for
# the gazelle they're built with.
bazel_dep(name = "rules_go", version = "0.62.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # So any host can build for Linux (the C side comes from the LLVM toolchain below).
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        # The web version (//web).
        "wasm32-wasip1",
        # The iOS app's engine (//crates/pdftools-ffi), for devices and the simulator.
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        # The Android app's engine, for devices and emulators.
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "wasm32-wasip1",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
        "aarch64-linux-android",
        "x86_64-linux-android",
    ],
)

# These look up the host's X11 library directories with pkg-config and bake
# them into the binary. Without pkg-config they fall back to the loader's
# search path, which is what a portable binary wants anyway.
[crate.annotation(
    build_script_env = {"PKG_CONFIG": "/nonexistent/pkg-config"},
    crate = name,
) for name in [
    "tiny-xlib",
    "x11-dl",
]]

# Fixes for panics the render fuzz target found in hayro 0.8.0 on malformed
# files; remove each once a hayro release includes it. fuzz/patch-crates.sh
# applies the same patches to the fuzz build.
crate.annotation(
    crate = "hayro-syntax",
    patch_args = ["-p1"],
    patches = ["//third_party/patches:hayro-syntax-unreadable-items.patch"],
    version = "0.8.0",
)

crate.annotation(
    crate = "hayro-interpret",
    patch_args = ["-p1"],
    patches = ["//third_party/patches:hayro-interpret-rgb-length.patch"],
    version = "0.8.0",
)

use_repo(crate, "crates")

# Linux builds compile and link with hermetic-llvm: LLVM and its tools are
# self-contained, and the C runtime (glibc 2.28 stubs and headers, libc++,
# compiler-rt) is built from source, so nothing comes from the host. macOS
# and Windows keep the system toolchain (Xcode and MSVC).
toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
toolchain.exec(arch = "x86_64", os = "linux")
toolchain.exec(arch = "aarch64", os = "linux")
toolchain.exec(arch = "aarch64", os = "macos")
toolchain.target(arch = "x86_64", os = "linux")
toolchain.target(arch = "aarch64", os = "linux")
use_repo(toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

# The Android SDK and NDK (a dev dependency, as the extension requires). The licence versions accepted for them are in .bazelrc.
android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(
    build_tools_version = "36.0.0",
    version = "36",
)
android.ndk(version = "r29")
# android/run.sh starts the emulator, with the system image below.
android.emulator(version = "37.1.11")
use_repo(android, "androidndk", "androidsdk")

# The emulator's system images: arm64 for Apple silicon, x86_64 for Intel
# and CI (Linux with KVM). Not android.system_image(): those download with
# the SDK, which rules_android loads in every build; these only download when
# android/run.sh needs one.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

[http_archive(
    name = "android_system_image_36_" + arch,
    build_file_content = 'exports_files(["source.properties"], visibility = ["//visibility:public"])\nfilegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])',
    sha256 = sha256,
    strip_prefix = abi,
    urls = ["https://dl.google.com/android/repository/sys-img/android/%s-36_r02.zip" % abi],
) for arch, abi, sha256 in [
    ("arm64", "arm64-v8a", "c6194eb8ace128b174ea86b5fbc0c78204147123b3b5ce6d0e3d615a06ad31d1"),
    ("x86_64", "x86_64", "e1b9d9fb665001ef27b16e57d8762a2d54aec6bff617e17506edb8676667b9da"),
]]

# rules_android and rules_android_ndk use the downloaded SDK and NDK.
android_sdk = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension", dev_dependency = True)
override_repo(android_sdk, "androidsdk")
android_ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension", dev_dependency = True)
override_repo(android_ndk, "androidndk")

# The SDK, NDK and Kotlin toolchains are registered by `--config=android`
# (.bazelrc), so other builds don't download the SDK.

# The Android app's libraries (Jetpack Compose), pinned in android/maven_install.json:
# `bazel run @android_maven//:pin` after changing them.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "android_maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "androidx.activity:activity-compose:1.13.0",
        # Pinned to the versions activity-compose needs (Compose asks for older ones).
        "androidx.activity:activity:1.13.0",
        "androidx.activity:activity-ktx:1.13.0",
        "androidx.compose.foundation:foundation",
        "androidx.compose.material3:material3",
        # Its last release; Compose's BOM no longer lists it.
        "androidx.compose.material:material-icons-extended:1.7.8",
        "androidx.core:core-ktx:1.19.1",
        "androidx.compose.ui:ui",
        "androidx.compose.ui:ui-tooling-preview",
        "androidx.lifecycle:lifecycle-viewmodel-compose:2.11.0",
        "org.jetbrains.kotlin:kotlin-compose-compiler-plugin-embeddable:2.4.21",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.11.0",
    ],
    # AndroidX pins exact versions of its siblings, which old and new libraries
    # disagree on; take the newest instead, as Gradle does.
    additional_coursier_options = ["--reconciliation=*:*:relaxed"],
    boms = ["androidx.compose:compose-bom:2026.09.00"],
    # The Kotlin standard library comes from rules_kotlin, matching the compiler.
    excluded_artifacts = [
        "org.jetbrains.kotlin:kotlin-stdlib",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk7",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk8",
    ],
    lock_file = "//android:maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(maven, "android_maven")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.10")
