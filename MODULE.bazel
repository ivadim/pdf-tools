"""PDF Tools, built with Bazel. Third-party crates come from Cargo.toml and Cargo.lock."""

module(name = "pdftools")

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "platforms", version = "1.1.0")
# Xcode's toolchain and the iOS platforms, for the iOS app's engine.
bazel_dep(name = "apple_support", version = "2.8.0")
bazel_dep(name = "llvm", version = "0.8.24")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # So any host can build for Linux (the C side comes from the LLVM toolchain below).
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        # The web version (//web).
        "wasm32-wasip1",
        # The iOS app's engine (//crates/pdftools-ffi), for devices and the simulator.
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
    ],
    versions = ["1.98.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "wasm32-wasip1",
        "aarch64-apple-ios",
        "aarch64-apple-ios-sim",
    ],
)

# These look up the host's X11 library directories with pkg-config and bake
# them into the binary. Without pkg-config they fall back to the loader's
# search path, which is what a portable binary wants anyway.
[crate.annotation(
    build_script_env = {"PKG_CONFIG": "/nonexistent/pkg-config"},
    crate = name,
) for name in [
    "tiny-xlib",
    "x11-dl",
]]

# hayro-interpret 0.8.0 panics on malformed RGB colours and images (found by
# the render fuzz target); the patch returns "can't convert" instead. Remove
# once a hayro release includes it. fuzz/patch-crates.sh applies the same patch.
crate.annotation(
    crate = "hayro-interpret",
    patch_args = ["-p1"],
    patches = ["//third_party/patches:hayro-interpret-rgb-length.patch"],
    version = "0.8.0",
)

use_repo(crate, "crates")

# Linux builds compile and link with hermetic-llvm: LLVM and its tools are
# self-contained, and the C runtime (glibc 2.28 stubs and headers, libc++,
# compiler-rt) is built from source, so nothing comes from the host. macOS
# and Windows keep the system toolchain (Xcode and MSVC).
toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
toolchain.exec(arch = "x86_64", os = "linux")
toolchain.exec(arch = "aarch64", os = "linux")
toolchain.exec(arch = "aarch64", os = "macos")
toolchain.target(arch = "x86_64", os = "linux")
toolchain.target(arch = "aarch64", os = "linux")
use_repo(toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")
