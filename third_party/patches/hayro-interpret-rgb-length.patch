 impl ToRgb for DeviceRgb {
     fn convert(&self, input: &[u8], output: &mut [u8]) -> Option<()> {
+        // pdf-tools patch: malformed colours and images can give a different
+        // number of components; copy_from_slice would panic.
+        if input.len() != output.len() {
+            return None;
+        }
         output.copy_from_slice(input);
 
         Some(())
