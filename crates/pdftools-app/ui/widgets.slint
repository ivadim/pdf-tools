// Small building blocks shared by the screens.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component Icon inherits Image {
    in property <image> icon;
    in property <color> tint: Theme.text;
    in property <length> size: 18px;
    source: icon;
    colorize: tint;
    width: size;
    height: size;
    image-fit: contain;
}

// A coloured rounded square with a tool's icon.
export component ToolChip inherits Rectangle {
    in property <image> icon;
    in property <color> tint;
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: size * 0.28;
    background: tint.with-alpha(0.16);
    Icon {
        icon: root.icon;
        tint: root.tint;
        size: root.size * 0.52;
    }
}

export enum ButtonKind { normal, primary, ghost }

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <ButtonKind> kind: normal;
    in property <bool> enabled: true;
    in property <bool> small: false;
    in property <bool> large: false;
    in property <string> tooltip;
    callback clicked();

    accessible-role: button;
    accessible-label: text;
    accessible-description: tooltip;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }

    height: large ? 42px : small ? 30px : 34px;
    min-width: layout.min-width;
    border-radius: 8px;
    border-width: kind == ButtonKind.normal ? 1px : 0;
    border-color: Theme.border;
    background: kind == ButtonKind.primary
        ? (touch.has-hover && enabled ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover && enabled ? Theme.surface-3 : kind == ButtonKind.ghost ? transparent : Theme.surface);
    opacity: enabled ? 1 : 0.45;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    layout := HorizontalLayout {
        padding-left: root.small ? 10px : root.large ? 20px : 12px;
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: center;
        if root.has-icon: Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            size: root.small ? 15px : 17px;
            tint: root.kind == ButtonKind.primary ? white : Theme.text;
        }
        if root.text != "": Text {
            text: root.text;
            vertical-alignment: center;
            font-size: root.small ? 13px : Theme.font;
            font-weight: root.large ? 600 : 400;
            color: root.kind == ButtonKind.primary ? white : Theme.text;
            overflow: elide;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> size: 30px;
    in property <color> tint: Theme.muted;
    in property <bool> danger: false;
    callback clicked();

    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }

    width: size;
    height: size;
    border-radius: 7px;
    background: touch.has-hover && enabled ? Theme.surface-3 : transparent;
    opacity: enabled ? 1 : 0.4;
    Icon {
        icon: root.icon;
        size: root.size * 0.58;
        tint: touch.has-hover && root.enabled ? (root.danger ? Theme.error : Theme.text) : root.tint;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component SectionTitle inherits Text {
    font-size: 12px;
    font-weight: 650;
    color: Theme.muted;
    letter-spacing: 0.6px;
}

export component Muted inherits Text {
    color: Theme.muted;
    font-size: Theme.font-small;
    wrap: word-wrap;
}

export component Panel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
}

export struct SegmentOption {
    value: string,
    label: string,
    description: string,
}

// Mutually exclusive options; with descriptions they render as cards.
export component Segmented inherits VerticalLayout {
    in property <[SegmentOption]> options;
    in-out property <string> value;
    in property <bool> cards: false;
    callback changed(string);
    spacing: 6px;

    if !root.cards: Rectangle {
        height: 36px;
        border-radius: 9px;
        background: Theme.surface-3;
        HorizontalLayout {
            padding: 3px;
            spacing: 3px;
            for option in root.options: Rectangle {
                accessible-role: button;
                accessible-label: option.label;
                accessible-checkable: true;
                accessible-checked: option.value == root.value;
                accessible-action-default => { root.value = option.value; root.changed(option.value); }
                border-radius: 7px;
                background: option.value == root.value ? Theme.surface : transparent;
                drop-shadow-blur: option.value == root.value ? 2px : 0;
                drop-shadow-color: #0000001f;
                Text {
                    text: option.label;
                    color: option.value == root.value ? Theme.text : Theme.muted;
                    font-weight: option.value == root.value ? 600 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.value = option.value; root.changed(option.value); }
                }
            }
        }
    }
    if root.cards: VerticalLayout {
        spacing: 6px;
        for option in root.options: Rectangle {
            accessible-role: button;
            accessible-label: option.label;
            accessible-checkable: true;
            accessible-checked: option.value == root.value;
            accessible-action-default => { root.value = option.value; root.changed(option.value); }
            border-radius: 10px;
            border-width: 1px;
            border-color: option.value == root.value ? Theme.accent : Theme.border;
            background: option.value == root.value ? Theme.accent-soft : Theme.surface;
            VerticalLayout {
                padding: 9px;
                padding-left: 12px;
                spacing: 2px;
                Text { text: option.label; font-weight: 600; color: Theme.text; }
                if option.description != "": Muted { text: option.description; }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.value = option.value; root.changed(option.value); }
            }
        }
    }
}

// A labelled field wrapper.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 5px;
    Text { text: root.label; font-size: 13px; font-weight: 550; color: Theme.text; }
    @children
    if root.hint != "": Muted { text: root.hint; }
}

// A 3×3 (or 2×3) grid for choosing a position on the page.
export component AnchorPicker inherits Rectangle {
    in-out property <string> h: "center";
    in-out property <string> v: "bottom";
    in property <bool> middle-row: true;
    callback changed(string, string);
    property <[string]> hs: ["left", "center", "right"];
    property <[string]> vs: middle-row ? ["top", "middle", "bottom"] : ["top", "bottom"];

    width: 132px;
    height: vs.length * 32px + 8px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface-2;
    for vv[row] in root.vs: Rectangle {
        y: 4px + row * 32px;
        height: 28px;
        for hh[col] in root.hs: Rectangle {
            x: 4px + col * 41px;
            width: 40px;
            height: 28px;
            border-radius: 6px;
            background: (hh == root.h && vv == root.v) ? Theme.accent-soft : transparent;
            accessible-role: button;
            accessible-label: vv + " " + hh;
            accessible-checkable: true;
            accessible-checked: hh == root.h && vv == root.v;
            accessible-action-default => { root.h = hh; root.v = vv; root.changed(hh, vv); }
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: (hh == root.h && vv == root.v) ? Theme.accent : cell-touch.has-hover ? Theme.muted : Theme.border;
            }
            cell-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.h = hh; root.v = vv; root.changed(hh, vv); }
            }
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    height: 16px;
    width: label.preferred-width + 12px;
    border-radius: 8px;
    background: Theme.accent-soft;
    label := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: Theme.accent;
    }
}

export component Spinner inherits Rectangle {
    in property <length> size: 18px;
    width: size;
    height: size;
    Rectangle {
        transform-rotation: mod(animation-tick() / 2.2ms, 360) * 1deg;
        Path {
            width: root.size;
            height: root.size;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 12 2 A 10 10 0 0 1 22 12";
            stroke: Theme.accent;
            stroke-width: 2.5px;
        }
    }
}

// A text input whose text Rust can replace: it reloads `source` whenever
// `version` changes (ordinary bindings break once the user types).
export component SyncedLineEdit inherits Rectangle {
    in property <string> label;
    in property <string> source;
    in property <int> version;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    callback edited(string);
    callback accepted();
    height: edit.preferred-height;
    changed version => { edit.text = root.source; }
    edit := LineEdit {
        width: parent.width;
        accessible-label: root.label;
        text: root.source;
        placeholder-text: root.placeholder;
        input-type: root.input-type;
        edited(t) => { root.edited(t); }
        accepted => { root.accepted(); }
    }
}
