// Signature: create a signature, then place boxes of it on pages.
import { ScrollView, LineEdit, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconButton, Button, ButtonKind, Muted, SectionTitle, Panel, Segmented, Field, Spinner } from "widgets.slint";
import { Tools, Sign, SignBox } from "model.slint";
import { ToolHeader, RunBar, FileCardView } from "common.slint";

component SignatureBox inherits Rectangle {
    in property <SignBox> box;
    in property <length> page-width;
    in property <length> page-height;
    in property <image> signature;
    in property <float> signature-aspect;
    // Offsets while being dragged, committed on release.
    property <length> dx;
    property <length> dy;
    property <length> dw;

    x: box.x * page-width + dx;
    y: box.y * page-height + dy;
    width: box.width * page-width + dw;
    height: self.width / signature-aspect;
    border-width: 1.5px;
    border-color: Theme.accent;
    border-radius: 3px;
    background: drag.has-hover || focus.has-focus ? Theme.accent.with-alpha(0.08) : transparent;

    accessible-role: button;
    accessible-label: "Signature; drag to move";

    function commit() {
        Sign.box-changed(root.box.id,
            clamp((root.box.x * root.page-width + root.dx) / root.page-width, 0, 1 - (root.box.width * root.page-width + root.dw) / root.page-width),
            clamp((root.box.y * root.page-height + root.dy) / root.page-height, 0, 1),
            clamp((root.box.width * root.page-width + root.dw) / root.page-width, 0.05, 1),
            (root.box.width * root.page-width + root.dw) / root.signature-aspect / root.page-height);
        root.dx = 0; root.dy = 0; root.dw = 0;
    }

    Image { source: root.signature; width: parent.width; height: parent.height; image-fit: contain; }
    drag := TouchArea {
        mouse-cursor: move;
        moved => {
            if (self.pressed) {
                root.dx += self.mouse-x - self.pressed-x;
                root.dy += self.mouse-y - self.pressed-y;
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { focus.focus(); }
            if (event.kind == PointerEventKind.up) { root.commit(); }
        }
    }
    focus := FocusScope {
        width: 0; height: 0;
        key-pressed(event) => {
            if (event.text == Key.Delete || event.text == Key.Backspace) { Sign.box-removed(root.box.id); return accept; }
            if (event.text == Key.LeftArrow) { root.dx = -(event.modifiers.shift ? 0.05 : 0.01) * root.page-width; root.commit(); return accept; }
            if (event.text == Key.RightArrow) { root.dx = (event.modifiers.shift ? 0.05 : 0.01) * root.page-width; root.commit(); return accept; }
            if (event.text == Key.UpArrow) { root.dy = -(event.modifiers.shift ? 0.05 : 0.01) * root.page-height; root.commit(); return accept; }
            if (event.text == Key.DownArrow) { root.dy = (event.modifiers.shift ? 0.05 : 0.01) * root.page-height; root.commit(); return accept; }
            reject
        }
    }
    Rectangle {
        x: parent.width - 6px;
        y: parent.height - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 2px;
        border-color: Theme.surface;
        background: Theme.accent;
        TouchArea {
            mouse-cursor: nwse-resize;
            moved => { if (self.pressed) { root.dw += self.mouse-x - self.pressed-x; } }
            pointer-event(event) => { if (event.kind == PointerEventKind.up) { root.commit(); } }
        }
    }
    if drag.has-hover || focus.has-focus: Rectangle {
        x: parent.width - 12px;
        y: -12px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: Theme.surface;
        drop-shadow-blur: 4px;
        drop-shadow-color: #0000004d;
        IconButton {
            size: 24px;
            icon: @image-url("icons/x.svg");
            label: "Remove signature";
            clicked => { Sign.box-removed(root.box.id); }
        }
    }
}

export component SignaturePage inherits VerticalLayout {
    property <int> tool: 10;
    property <bool> busy: Tools.views[10].run.kind == 1;
    property <string> source: "draw";

    padding: 20px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 0;
    spacing: 16px;

    ToolHeader { info: Tools.catalog[10]; }

    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;
        Panel {
            min-width: 300px;
            max-width: 360px;
            ScrollView {
                VerticalLayout {
                    padding: 14px;
                    spacing: 18px;
                    alignment: start;
                    FileCardView { tool: 10; card: Tools.views[10].file; busy: root.busy; }
                    VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "YOUR SIGNATURE"; }
                        Segmented {
                            value <=> root.source;
                            options: [{ value: "draw", label: "Draw" }, { value: "type", label: "Type" }, { value: "upload", label: "Image" }];
                            changed(v) => { Tools.option(10, "source", v); }
                        }
                        if root.source == "draw": Rectangle {
                            height: 150px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: white;
                            clip: true;
                            accessible-role: groupbox;
                            accessible-label: "Signature pad";
                            if Sign.ink-path == "": Text {
                                x: 16px; y: parent.height - 40px;
                                text: "Sign here"; color: #9aa0ad; font-size: 12px;
                            }
                            Rectangle { x: 16px; y: parent.height - 28px; width: parent.width - 32px; height: 1px; background: #d5d8e0; }
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-x: 0;
                                viewbox-y: 0;
                                viewbox-width: parent.width / 1px;
                                viewbox-height: parent.height / 1px;
                                commands: Sign.ink-path;
                                stroke: Sign.ink;
                                stroke-width: 3px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                            }
                            TouchArea {
                                mouse-cursor: crosshair;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) { Sign.pad-down(self.mouse-x, self.mouse-y); }
                                    if (event.kind == PointerEventKind.up) { Sign.pad-up(); }
                                }
                                moved => { if (self.pressed) { Sign.pad-move(self.mouse-x, self.mouse-y); } }
                            }
                        }
                        if root.source == "draw": HorizontalLayout {
                            alignment: start;
                            Button {
                                small: true; text: "Clear"; has-icon: true; icon: @image-url("icons/trash.svg");
                                clicked => { Sign.pad-clear(); }
                            }
                        }
                        if root.source == "type": VerticalLayout {
                            spacing: 10px;
                            Field {
                                label: "Name";
                                LineEdit {
                                    accessible-label: "Name";
                                    placeholder-text: "Your name";
                                    edited(t) => { Tools.option(10, "name", t); }
                                }
                            }
                            Field {
                                label: "Style";
                                ComboBox {
                                    accessible-label: "Style";
                                    model: ["Handwriting", "Serif", "Sans-serif"];
                                    current-value: "Handwriting";
                                    selected(v) => { Tools.option(10, "font", v); }
                                }
                            }
                        }
                        if root.source == "upload": VerticalLayout {
                            spacing: 6px;
                            Button {
                                has-icon: true; icon: @image-url("icons/image.svg");
                                text: Sign.upload-name != "" ? Sign.upload-name : "Choose image…";
                                clicked => { Sign.choose-image(); }
                            }
                            Muted { text: "A PNG with a transparent background looks best."; }
                        }
                        if root.source != "draw" && Sign.has-signature: Rectangle {
                            height: 90px;
                            border-radius: 8px;
                            background: white;
                            Image { source: Sign.signature; width: parent.width - 16px; height: parent.height - 16px; image-fit: contain; }
                        }
                        if root.source != "upload": HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: "Ink"; color: Theme.text; vertical-alignment: center; }
                            for c[i] in [#1d2c6b, #000000, #2f5bd3, #c43d3d]: Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: c;
                                border-width: c == Sign.ink ? 3px : 1px;
                                border-color: c == Sign.ink ? Theme.accent : Theme.border;
                                accessible-role: button;
                                accessible-label: "Ink " + (i + 1);
                                accessible-action-default => { Tools.option(10, "ink", i); }
                                TouchArea { mouse-cursor: pointer; clicked => { Tools.option(10, "ink", i); } }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "PLACEMENT"; }
                        Muted { text: "Add the signature, then drag it into place. Drag the corner to resize."; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button {
                                small: true; kind: ButtonKind.primary; has-icon: true; icon: @image-url("icons/plus.svg");
                                text: "Add to this page";
                                enabled: Sign.has-signature && Tools.views[10].file.state == 2;
                                clicked => { Sign.add-box(false); }
                            }
                            Button {
                                small: true; has-icon: true; icon: @image-url("icons/copy.svg");
                                text: "Add to every page";
                                enabled: Sign.has-signature && Tools.views[10].file.state == 2;
                                clicked => { Sign.add-box(true); }
                            }
                        }
                    }
                }
            }
        }
        Panel {
            horizontal-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 46px;
                    HorizontalLayout {
                        padding-left: 14px;
                        spacing: 10px;
                        alignment: center;
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("icons/chevron-left.svg"); label: "Previous page"; enabled: Sign.can-prev;
                            clicked => { Sign.page-step(-1); }
                        }
                        Text { text: Sign.page-label; color: Theme.muted; vertical-alignment: center; }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("icons/chevron-right.svg"); label: "Next page"; enabled: Sign.can-next;
                            clicked => { Sign.page-step(1); }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
                stage := Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-2;
                    property <length> avail-w: self.width - 40px;
                    property <length> avail-h: self.height - 40px;
                    property <bool> wide: Sign.page-aspect > avail-w / max(1px, avail-h);
                    if Tools.views[10].file.state != 2: Muted {
                        text: "Choose a PDF to place your signature.";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if Tools.views[10].file.state == 2: page := Rectangle {
                        width: stage.wide ? stage.avail-w : stage.avail-h * Sign.page-aspect;
                        height: stage.wide ? stage.avail-w / Sign.page-aspect : stage.avail-h;
                        background: white;
                        drop-shadow-blur: 12px;
                        drop-shadow-color: #00000033;
                        if Sign.page-loaded: Image { source: Sign.page-image; width: parent.width; height: parent.height; image-fit: fill; }
                        if !Sign.page-loaded: Spinner { }
                        for box in Sign.boxes: SignatureBox {
                            box: box;
                            page-width: page.width;
                            page-height: page.height;
                            signature: Sign.signature;
                            signature-aspect: Sign.signature-aspect;
                        }
                    }
                }
            }
        }
    }

    RunBar { tool: 10; run: Tools.views[10].run; icon: Tools.catalog[10].icon; }
}
