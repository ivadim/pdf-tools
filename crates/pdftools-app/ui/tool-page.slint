import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, SectionTitle, Panel, IconButton } from "widgets.slint";
import { PageGrid } from "page-grid.slint";
import { Tools, ToolView, ToolInfo } from "model.slint";
import { ToolHeader, RunBar, FileCardView, HeaderAction } from "common.slint";
import {
    ToolUi, SplitOptions, CompressOptions, ProtectOptions, UnlockOptions, PageNumbersOptions, WatermarkOptions,
    MetadataOptions, GrayscaleOptions,
} from "tools.slint";

// The layout of a single-file tool: options on the left, pages on the right.
//
// Each tool's options are chosen by index rather than passed as children:
// a component with children is copied into every user, and this one is big.
export component ToolPage inherits VerticalLayout {
    in property <int> tool;
    property <ToolInfo> info: Tools.catalog[tool];
    property <ToolView> view: Tools.views[tool];
    property <bool> busy: view.run.kind == 1;
    // Tools that stamp something preview the result rather than list pages.
    property <string> preview-title: tool == 7 || tool == 8 || tool == 11 ? "Preview" : "Pages";
    property <[HeaderAction]> actions:
        tool == 1 ? [
            { id: "select-all", label: "Select all pages", icon: @image-url("icons/select-all.svg"), visible: ToolUi.split-mode == "extract" },
            { id: "clear-selection", label: "Clear selection", icon: @image-url("icons/x.svg"), visible: ToolUi.split-mode == "extract" },
        ]
        : tool == 5 ? [
            { id: "rotate-all-left", label: "Rotate all left", icon: @image-url("icons/rotate-ccw.svg"), visible: true },
            { id: "rotate-all-right", label: "Rotate all right", icon: @image-url("icons/rotate-cw.svg"), visible: true },
            { id: "reset", label: "Reset rotation", icon: @image-url("icons/reset.svg"), visible: true },
        ]
        : tool == 6 ? [
            { id: "reverse", label: "Reverse order", icon: @image-url("icons/reverse.svg"), visible: true },
            { id: "reset", label: "Reset to original order", icon: @image-url("icons/reset.svg"), visible: true },
        ]
        : [];

    padding: 20px;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 0;
    spacing: 16px;

    ToolHeader { info: root.info; }

    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;
        Panel {
            min-width: 300px;
            max-width: 360px;
            horizontal-stretch: 0;
            ScrollView {
                VerticalLayout {
                    padding: 14px;
                    spacing: 18px;
                    alignment: start;
                    FileCardView { tool: root.tool; card: root.view.file; busy: root.busy; }
                    if root.tool == 1: SplitOptions { }
                    if root.tool == 2: CompressOptions { }
                    if root.tool == 3: ProtectOptions { }
                    if root.tool == 4: UnlockOptions { }
                    if root.tool == 7: PageNumbersOptions { }
                    if root.tool == 8: WatermarkOptions { }
                    if root.tool == 9: MetadataOptions { }
                    if root.tool == 11: GrayscaleOptions { }
                }
            }
        }
        Panel {
            horizontal-stretch: 1;
            VerticalLayout {
                Rectangle {
                    height: 46px;
                    border-width: 0;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        spacing: 10px;
                        SectionTitle { text: root.preview-title.to-uppercase(); vertical-alignment: center; }
                        Text { text: root.view.summary; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                        if root.view.include-all: Button {
                            y: (parent.height - self.height) / 2;
                            text: "Include all"; small: true; has-icon: true; icon: @image-url("icons/check.svg");
                            tooltip: "Put every page back in";
                            clicked => { Tools.grid-action(root.tool, "include-all"); }
                        }
                        for action in root.actions: HorizontalLayout {
                            if action.visible && action.text: Button {
                                y: (parent.height - self.height) / 2;
                                text: action.label; small: true; has-icon: true; icon: action.icon;
                                enabled: !root.busy;
                                clicked => { Tools.grid-action(root.tool, action.id); }
                            }
                            if action.visible && !action.text: IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: action.icon; label: action.label; enabled: !root.busy && root.view.pages.length > 0;
                                clicked => { Tools.grid-action(root.tool, action.id); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                }
                if root.view.notice != "": Rectangle {
                    height: 40px;
                    background: Theme.accent-soft;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        Text { text: root.view.notice; vertical-alignment: center; color: Theme.text; horizontal-stretch: 1; }
                        Button {
                            y: (parent.height - self.height) / 2;
                            text: "Reset to file order"; small: true; has-icon: true; icon: @image-url("icons/reset.svg");
                            clicked => { Tools.grid-action(root.tool, "reset-order"); }
                        }
                    }
                }
                PageGrid {
                    vertical-stretch: 1;
                    pages: root.view.pages;
                    caps: root.view.caps;
                    busy: root.busy;
                    empty-text: root.view.empty-text;
                    tile-clicked(index, shift, ctrl) => { Tools.tile-clicked(root.tool, index, shift, ctrl); }
                    tile-action(action, index) => { Tools.tile-action(root.tool, action, index); }
                    moved(from, to) => { Tools.tile-moved(root.tool, from, to); }
                    include-range(from, to, include) => { Tools.include-range(root.tool, from, to, include); }
                    visible-range(first, last) => { Tools.visible-range(root.tool, first, last); }
                }
            }
        }
    }

    RunBar { tool: root.tool; run: root.view.run; icon: root.info.icon; }
}
