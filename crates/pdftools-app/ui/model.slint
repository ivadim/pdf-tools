// Data shared between Rust and the UI. Rust owns all state and pushes it here;
// the UI reports user actions back through the callbacks on `Tools`.

// One page in a preview grid.
export struct PageTile {
    // Identifies the rendered image, so finished renders find their tile.
    key: string,
    // Original page number in its source file (1-based).
    page: int,
    image: image,
    loaded: bool,
    failed: bool,
    // Displayed width / height (after rotation), for sizing before load.
    aspect: float,
    label: string,
    badge: string,
    rotation: int,
    stripe: color,
    has-stripe: bool,
    selected: bool,
    dimmed: bool,
    excluded: bool,
    caption: string,
    // Text overlay (page-number preview): anchor point as fractions of the
    // page box, alignment of the text around it (0 = start, 0.5 = centre,
    // 1 = end), size as a fraction of the page width.
    overlay-text: string,
    overlay-x: float,
    overlay-y: float,
    overlay-align-x: float,
    overlay-align-y: float,
    overlay-size: float,
    overlay-color: color,
    // Image overlay (watermark preview): centre, width as a fraction of the
    // page width, counter-clockwise angle in degrees, opacity.
    overlay-image: image,
    has-overlay-image: bool,
    overlay-image-x: float,
    overlay-image-y: float,
    overlay-image-width: float,
    overlay-image-angle: float,
    overlay-image-opacity: float,
}

// Which page operations a grid offers.
export struct GridCaps {
    reorder: bool,
    rotate: bool,
    delete: bool,
    duplicate: bool,
    select: bool,
    include: bool,
}

export struct RunState {
    // Shown when the tool can't run yet; empty when ready.
    hint: string,
    label: string,
    // 0 idle, 1 running, 2 done, 3 failed.
    kind: int,
    // -1 while progress is unknown.
    progress: float,
    message: string,
    output: string,
    output-name: string,
}

export struct FileCard {
    // 0 empty, 1 loading, 2 loaded, 3 error.
    state: int,
    name: string,
    path: string,
    details: string,
    error: string,
    locked: bool,
    restricted: bool,
    thumb: image,
    has-thumb: bool,
}

// Everything a tool page shows that isn't tool-specific.
export struct ToolView {
    file: FileCard,
    pages: [PageTile],
    caps: GridCaps,
    run: RunState,
    summary: string,
    include-all: bool,
    notice: string,
    empty-text: string,
    // Tool-specific strings Rust may (re)set, e.g. metadata fields.
    texts: [string],
    // Bumped whenever `texts` is replaced, so inputs reload them.
    form-version: int,
    // Tool-specific flags.
    flags: [bool],
}

export struct ToolInfo {
    id: string,
    name: string,
    description: string,
    icon: image,
    tint: color,
    featured: bool,
}

export global Tools {
    in-out property <string> active: "home";
    in-out property <[ToolView]> views;
    in-out property <bool> catalog-open: true;
    in-out property <bool> dropping: false;

    out property <[ToolInfo]> catalog: [
        { id: "merge", name: "Merge", description: "Combine PDFs into one, and reorder or rotate their pages on the way", icon: @image-url("icons/merge.svg"), tint: #f43f5e, featured: true },
        { id: "split", name: "Split", description: "Divide a PDF into several files, or pull out the pages you need", icon: @image-url("icons/split.svg"), tint: #3b82f6, featured: true },
        { id: "compress", name: "Compress", description: "Reduce file size by cleaning up and re-encoding large images", icon: @image-url("icons/compress.svg"), tint: #f59e0b, featured: true },
        { id: "protect", name: "Protect", description: "Encrypt a PDF with a password (AES-256) and limit what others can do", icon: @image-url("icons/protect.svg"), tint: #6366f1, featured: true },
        { id: "unlock", name: "Unlock", description: "Remove the password and restrictions from a PDF you have access to", icon: @image-url("icons/unlock.svg"), tint: #a855f7, featured: false },
        { id: "rotate", name: "Rotate", description: "Turn pages upright — individually or all at once", icon: @image-url("icons/rotate.svg"), tint: #f97316, featured: false },
        { id: "rearrange", name: "Rearrange", description: "Reorder, duplicate or delete pages — bookmarks and forms are kept", icon: @image-url("icons/rearrange.svg"), tint: #22c55e, featured: false },
        { id: "page-numbers", name: "Page numbers", description: "Add page numbers in the position and style you choose", icon: @image-url("icons/page-numbers.svg"), tint: #38bdf8, featured: false },
        { id: "watermark", name: "Watermark", description: "Stamp text or a logo across your pages", icon: @image-url("icons/watermark.svg"), tint: #c084fc, featured: false },
        { id: "metadata", name: "Metadata", description: "View and edit the title, author, keywords and other document properties", icon: @image-url("icons/metadata.svg"), tint: #22d3ee, featured: false },
        { id: "signature", name: "Signature", description: "Draw, type or upload your signature and place it on the page", icon: @image-url("icons/signature.svg"), tint: #ec4899, featured: false },
        { id: "grayscale", name: "Grayscale", description: "Convert colours to shades of grey for printing — text stays sharp and selectable", icon: @image-url("icons/grayscale.svg"), tint: #a1a1aa, featured: false },
    ];

    callback navigate(string);
    // File card.
    callback pick-file(int);
    callback clear-file(int);
    callback unlock-file(int);
    // Run bar.
    callback run(int);
    callback reveal(int);
    // Page grid. Actions: "view", "rotate-left", "rotate-right", "delete",
    // "duplicate", "toggle-include".
    callback tile-clicked(int, int, bool, bool);
    callback tile-action(int, string, int);
    callback tile-moved(int, int, int);
    callback include-range(int, int, int, bool);
    callback visible-range(int, int, int);
    // Header actions, e.g. "include-all", "rotate-all-left", "reverse".
    callback grid-action(int, string);
    // Tool options, as key/value strings.
    callback option(int, string, string);
}

// The full-size page viewer.
export global Viewer {
    in-out property <bool> open;
    in-out property <PageTile> tile;
    in-out property <string> caption;
    in-out property <bool> can-prev;
    in-out property <bool> can-next;
    in-out property <bool> can-rotate;
    callback step(int);
    callback rotate(int);
    callback close();
}

export struct MergeFile {
    name: string,
    path: string,
    tint: color,
    meta: string,
    error: string,
    locked: bool,
    thumb: image,
    has-thumb: bool,
}

export global Merge {
    in-out property <[MergeFile]> files;
    in-out property <bool> custom-order;
    callback add-files();
    callback sort-files();
    callback clear-files();
    // Actions: "up", "down", "remove", "focus", "hover", "unhover".
    callback file-action(string, int);
    callback file-moved(int, int);
}

export struct SignBox {
    id: int,
    x: float,
    y: float,
    width: float,
    height: float,
}

export global Sign {
    in-out property <image> page-image;
    in-out property <bool> page-loaded;
    in-out property <float> page-aspect: 0.707;
    in-out property <string> page-label;
    in-out property <bool> can-prev;
    in-out property <bool> can-next;
    in-out property <[SignBox]> boxes;
    in-out property <image> signature;
    in-out property <bool> has-signature;
    in-out property <float> signature-aspect: 3;
    // Drawn strokes as SVG path commands in pad coordinates.
    in-out property <string> ink-path;
    in-out property <color> ink: #1d2c6b;
    in-out property <string> upload-name;
    callback pad-down(length, length);
    callback pad-move(length, length);
    callback pad-up();
    callback pad-clear();
    callback box-changed(int, float, float, float, float);
    callback box-removed(int);
    callback page-step(int);
    callback add-box(bool);
    callback choose-image();
}
