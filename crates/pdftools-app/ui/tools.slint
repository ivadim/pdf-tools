// Option panels of the single-file tools. Every change is reported to Rust
// as `Tools.option(tool, key, value)`; Rust validates and updates the view.
import { LineEdit, CheckBox, Slider, SpinBox, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, Muted, SectionTitle, Segmented, SegmentOption, Field, AnchorPicker, SyncedLineEdit } from "widgets.slint";
import { Tools, ToolView } from "model.slint";

// UI state that the page shell needs too.
export global ToolUi {
    in-out property <string> split-mode: "ranges";
}

// Base of the option panels shown in a tool page's left column.
component Options inherits VerticalLayout {
    in property <int> tool;
    in property <ToolView> view: Tools.views[tool];
    spacing: 18px;
    alignment: start;
}


component Section inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 10px;
    // Spare height goes below the section, not into its title.
    alignment: start;
    SectionTitle { text: root.title.to-uppercase(); }
    if root.hint != "": Muted { text: root.hint; }
    @children
}

component Swatches inherits HorizontalLayout {
    in-out property <color> value;
    in property <[color]> colors: [#000000, #1d2c6b, #2f5bd3, #c43d3d, #23885a, #6b7283];
    // Reports the index of the chosen colour.
    callback changed(int);
    spacing: 6px;
    alignment: start;
    for c[i] in root.colors: Rectangle {
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: c;
        border-width: c == root.value ? 3px : 1px;
        border-color: c == root.value ? Theme.accent : Theme.border;
        accessible-role: button;
        accessible-label: "Colour " + (i + 1);
        accessible-checkable: true;
        accessible-checked: c == root.value;
        accessible-action-default => { root.value = c; root.changed(i); }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.value = c; root.changed(i); }
        }
    }
}

component LabelledSlider inherits VerticalLayout {
    in property <string> label;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in-out property <float> value;
    in property <string> suffix;
    callback changed(float);
    spacing: 4px;
    HorizontalLayout {
        Text { text: root.label; font-size: 13px; font-weight: 550; color: Theme.text; horizontal-stretch: 1; }
        Text { text: round(root.value) + root.suffix; color: Theme.muted; font-size: 12.5px; }
    }
    Slider {
        accessible-label: root.label;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
}

export component SplitOptions inherits Options {
    tool: 1;
    property <string> mode <=> ToolUi.split-mode;

    Section {
        title: "Split method";
        Segmented {
            cards: true;
            value <=> root.mode;
            options: [
                { value: "ranges", label: "By ranges", description: "Each range becomes a file" },
                { value: "every", label: "Every N pages", description: "Equal-size chunks" },
                { value: "each", label: "Each page", description: "One file per page" },
                { value: "extract", label: "Extract pages", description: "Selected pages into one file" },
            ];
            changed(v) => { Tools.option(root.tool, "mode", v); }
        }
    }
    if root.mode == "ranges": Field {
        label: "Page ranges";
        hint: "Separate files with commas. “9-” runs to the last page.";
        SyncedLineEdit {
            label: "Page ranges";
            source: root.view.texts[0];
            version: root.view.form-version;
            placeholder: "e.g. 1-3, 4-8, 9-";
            edited(t) => { Tools.option(root.tool, "ranges", t); }
        }
    }
    if root.mode == "every": Field {
        label: "Pages per file";
        SpinBox {
            accessible-label: "Pages per file";
            minimum: 1;
            maximum: 9999;
            value: 1;
            edited(v) => { Tools.option(root.tool, "every", v); }
        }
    }
    if root.mode == "extract": Muted {
        text: "Click pages in the preview to select them. Shift-click selects a range, Ctrl-click toggles.";
    }
    if root.mode != "extract": Field {
        label: "File names";
        hint: "Files are numbered: name-1.pdf, name-2.pdf, …";
        SyncedLineEdit {
            label: "File names";
            source: root.view.texts[1];
            version: root.view.form-version;
            edited(t) => { Tools.option(root.tool, "base", t); }
        }
    }
}

export component CompressOptions inherits Options {
    tool: 2;
    Section {
        title: "Compression";
        Segmented {
            cards: true;
            value: "balanced";
            options: [
                { value: "lossless", label: "Lossless", description: "Removes unused data. Pages look exactly the same." },
                { value: "balanced", label: "Balanced", description: "Images up to 2000 px at good JPEG quality. Recommended." },
                { value: "strong", label: "Strong", description: "Images up to 1200 px at lower quality. Smallest files." },
            ];
            changed(v) => { Tools.option(root.tool, "level", v); }
        }
    }
}

export component ProtectOptions inherits Options {
    tool: 3;
    property <bool> show: false;
    Section {
        title: "Password";
        Field {
            label: "Password to open the file";
            LineEdit {
                accessible-label: "Password";
                input-type: root.show ? InputType.text : InputType.password;
                placeholder-text: "Password";
                edited(t) => { Tools.option(root.tool, "password", t); }
            }
        }
        Field {
            label: "Repeat password";
            LineEdit {
                accessible-label: "Repeat password";
                input-type: root.show ? InputType.text : InputType.password;
                placeholder-text: "Password again";
                edited(t) => { Tools.option(root.tool, "confirm", t); }
            }
        }
        CheckBox { text: "Show passwords"; checked <=> root.show; }
    }
    Section {
        title: "Permissions";
        hint: "Most PDF readers honour these, but they aren’t enforced by the encryption itself.";
        CheckBox { text: "Printing"; checked: true; toggled => { Tools.option(root.tool, "print", self.checked ? "1" : "0"); } }
        CheckBox { text: "Copying text and images"; checked: true; toggled => { Tools.option(root.tool, "copy", self.checked ? "1" : "0"); } }
        CheckBox { text: "Editing pages"; checked: true; toggled => { Tools.option(root.tool, "modify", self.checked ? "1" : "0"); } }
        CheckBox { text: "Comments and form filling"; checked: true; toggled => { Tools.option(root.tool, "annotate", self.checked ? "1" : "0"); } }
        Field {
            label: "Permissions password (optional)";
            hint: "If empty and something is restricted, a random one is used so the restrictions can’t be lifted.";
            LineEdit {
                accessible-label: "Permissions password";
                input-type: root.show ? InputType.text : InputType.password;
                placeholder-text: "Optional";
                edited(t) => { Tools.option(root.tool, "owner", t); }
            }
        }
    }
}

export component UnlockOptions inherits Options {
    tool: 4;
    // flags: [0] file loaded, [1] needs a password, [2] encrypted at all.
    if root.view.flags[0] && !root.view.flags[2]: Section {
        title: "Nothing to unlock";
        Muted { text: "This file has no password or restrictions."; }
    }
    if root.view.flags[0] && root.view.flags[2] && !root.view.flags[1]: Section {
        title: "Restrictions only";
        Muted { text: "This file opens without a password but limits printing, copying or editing. Unlocking removes those limits."; }
    }
    if root.view.flags[0] && root.view.flags[1]: Section {
        title: "Password";
        Field {
            label: "Password to open the file";
            LineEdit {
                accessible-label: "Password";
                input-type: InputType.password;
                placeholder-text: "Password";
                edited(t) => { Tools.option(root.tool, "password", t); }
                accepted => { Tools.run(root.tool); }
            }
        }
    }
}

export component PageNumbersOptions inherits Options {
    tool: 7;
    property <string> which: "all";
    property <string> format: "{n}";
    Section {
        title: "Position";
        AnchorPicker {
            middle-row: false;
            h: "center";
            v: "bottom";
            changed(h, v) => { Tools.option(root.tool, "anchor", v + " " + h); }
        }
    }
    Section {
        title: "Text";
        Field {
            label: "Format";
            hint: "{n} is the page number, {total} the last number.";
            format-edit := LineEdit {
                accessible-label: "Format";
                text: root.format;
                edited(t) => { root.format = t; Tools.option(root.tool, "format", t); }
            }
        }
        // Two rows, so every preset fits the panel without being cut off.
        VerticalLayout {
            spacing: 6px;
            for row in [["{n}", "Page {n}"], ["Page {n} of {total}", "{n} / {total}"]]: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for preset in row: Button {
                    small: true;
                    text: preset;
                    clicked => { root.format = preset; format-edit.text = preset; Tools.option(root.tool, "format", preset); }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Field {
                label: "Size (pt)";
                SpinBox { accessible-label: "Size"; minimum: 4; maximum: 72; value: 11; edited(v) => { Tools.option(root.tool, "size", v); } }
            }
            Field {
                label: "Margin (pt)";
                SpinBox { accessible-label: "Margin"; minimum: 0; maximum: 200; value: 28; edited(v) => { Tools.option(root.tool, "margin", v); } }
            }
        }
        Field {
            label: "Colour";
            Swatches { value: #000000; changed(i) => { Tools.option(root.tool, "color", i); } }
        }
    }
    Section {
        title: "Pages";
        Segmented {
            value <=> root.which;
            options: [{ value: "all", label: "All pages" }, { value: "custom", label: "Some pages" }];
            changed(v) => { Tools.option(root.tool, "which", v); }
        }
        if root.which == "custom": Field {
            label: "Pages to number";
            hint: "“2-” skips the cover page.";
            LineEdit {
                accessible-label: "Pages to number";
                text: "2-";
                edited(t) => { Tools.option(root.tool, "pages", t); }
            }
        }
        Field {
            label: "First number";
            SpinBox { accessible-label: "First number"; minimum: 0; maximum: 99999; value: 1; edited(v) => { Tools.option(root.tool, "start", v); } }
        }
    }
}

export component WatermarkOptions inherits Options {
    tool: 8;
    property <string> kind: "text";
    property <string> which: "all";
    Section {
        title: "Watermark";
        Segmented {
            value <=> root.kind;
            options: [{ value: "text", label: "Text" }, { value: "image", label: "Image" }];
            changed(v) => { Tools.option(root.tool, "kind", v); }
        }
        if root.kind == "text": VerticalLayout {
            spacing: 10px;
            Field {
                label: "Text";
                LineEdit {
                    accessible-label: "Watermark text";
                    text: "CONFIDENTIAL";
                    placeholder-text: "e.g. DRAFT";
                    edited(t) => { Tools.option(root.tool, "text", t); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Field {
                    label: "Font";
                    ComboBox {
                        accessible-label: "Font";
                        model: ["Sans-serif", "Serif", "Monospace", "Handwriting"];
                        current-value: "Sans-serif";
                        selected(v) => { Tools.option(root.tool, "font", v); }
                    }
                }
                Field {
                    label: "Style";
                    CheckBox { text: "Bold"; checked: true; toggled => { Tools.option(root.tool, "bold", self.checked ? "1" : "0"); } }
                }
            }
            Field {
                label: "Colour";
                Swatches {
                    colors: [#d03030, #000000, #6b7283, #2f5bd3, #23885a, #c77c12];
                    value: #d03030;
                    changed(i) => { Tools.option(root.tool, "color", i); }
                }
            }
        }
        if root.kind == "image": VerticalLayout {
            spacing: 6px;
            Button {
                has-icon: true;
                icon: @image-url("icons/image.svg");
                text: root.view.texts[0] != "" ? root.view.texts[0] : "Choose image…";
                clicked => { Tools.option(root.tool, "choose-image", ""); }
            }
            Muted { text: root.view.texts[1] != "" ? root.view.texts[1] : "PNG with transparency works best."; color: root.view.texts[1] != "" ? Theme.error : Theme.muted; }
        }
    }
    Section {
        title: "Placement";
        AnchorPicker { h: "center"; v: "middle"; changed(h, v) => { Tools.option(root.tool, "anchor", v + " " + h); } }
        LabelledSlider { label: "Size"; minimum: 5; maximum: 100; value: 70; suffix: "% of width"; changed(v) => { Tools.option(root.tool, "width", round(v)); } }
        LabelledSlider { label: "Angle"; minimum: -90; maximum: 90; step: 5; value: 45; suffix: "°"; changed(v) => { Tools.option(root.tool, "angle", round(v)); } }
        LabelledSlider { label: "Opacity"; minimum: 5; maximum: 100; step: 5; value: 30; suffix: "%"; changed(v) => { Tools.option(root.tool, "opacity", round(v)); } }
        CheckBox { text: "Behind page content"; toggled => { Tools.option(root.tool, "under", self.checked ? "1" : "0"); } }
    }
    Section {
        title: "Pages";
        Segmented {
            value <=> root.which;
            options: [{ value: "all", label: "All pages" }, { value: "custom", label: "Some pages" }];
            changed(v) => { Tools.option(root.tool, "which", v); }
        }
        if root.which == "custom": LineEdit {
            accessible-label: "Pages to watermark";
            text: "1";
            placeholder-text: "e.g. 1, 3-5";
            edited(t) => { Tools.option(root.tool, "pages", t); }
        }
    }
}

export component MetadataOptions inherits Options {
    tool: 9;
    if root.view.file.state == 2: Section {
        title: "Document properties";
        for field[i] in [
            { key: "title", label: "Title", placeholder: "Document title" },
            { key: "author", label: "Author", placeholder: "Who wrote it" },
            { key: "subject", label: "Subject", placeholder: "What it’s about" },
            { key: "keywords", label: "Keywords", placeholder: "Comma-separated" },
            { key: "creator", label: "Created with", placeholder: "Application that made the original" },
            { key: "producer", label: "Producer", placeholder: "Application that wrote the PDF" },
        ]: Field {
            label: field.label;
            SyncedLineEdit {
                label: field.label;
                source: root.view.texts[i];
                version: root.view.form-version;
                placeholder: field.placeholder;
                edited(t) => { Tools.option(root.tool, field.key, t); }
            }
        }
        HorizontalLayout { Text { text: "Created"; color: Theme.muted; horizontal-stretch: 1; } Text { text: root.view.texts[6]; color: Theme.text; } }
        HorizontalLayout { Text { text: "Modified"; color: Theme.muted; horizontal-stretch: 1; } Text { text: root.view.texts[7]; color: Theme.text; } }
        Button {
            small: true; has-icon: true; icon: @image-url("icons/trash.svg"); text: "Clear all fields";
            clicked => { Tools.option(root.tool, "clear", ""); }
        }
    }
}

export component GrayscaleOptions inherits Options {
    tool: 11;
    Section {
        title: "Options";
        CheckBox { text: "Convert images"; checked: true; toggled => { Tools.option(root.tool, "images", self.checked ? "1" : "0"); } }
        Muted { text: "Text and shapes are converted while staying sharp and selectable. Gradients and spot colours keep their colour."; }
    }
}
