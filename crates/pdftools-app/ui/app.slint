// The application window: sidebar, home catalog, tool pages and overlays.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconButton, ToolChip, Muted } from "widgets.slint";
import { Tools, Viewer, Merge, Sign, ToolInfo, ToolView, PageTile, MergeFile, SignBox, GridCaps, RunState, FileCard } from "model.slint";
import { PageCanvas } from "page-grid.slint";
import { MergePage } from "merge.slint";
import { SignaturePage } from "signature.slint";
import { ToolPage } from "tool-page.slint";

export { Tools, Viewer, Merge, Sign, ToolInfo, ToolView, PageTile, MergeFile, SignBox, GridCaps, RunState, FileCard }

component NavItem inherits Rectangle {
    in property <string> id;
    in property <string> name;
    in property <image> icon;
    in property <color> tint;
    height: 36px;
    border-radius: 9px;
    background: Tools.active == id ? Theme.surface : touch.has-hover ? Theme.surface-3 : transparent;
    drop-shadow-blur: Tools.active == id ? 2px : 0;
    drop-shadow-color: #00000014;
    accessible-role: tab;
    accessible-label: name;
    accessible-item-selected: Tools.active == id;
    accessible-action-default => { Tools.navigate(id); }
    HorizontalLayout {
        padding-left: 8px;
        spacing: 10px;
        ToolChip { y: 5px; icon: root.icon; tint: root.tint; size: 26px; }
        Text {
            text: root.name;
            vertical-alignment: center;
            color: Theme.text;
            font-weight: Tools.active == root.id ? 600 : 400;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { Tools.navigate(root.id); } }
}

component ToolCard inherits Rectangle {
    in property <ToolInfo> info;
    min-height: 92px;
    border-radius: 16px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent.with-alpha(0.5) : Theme.border;
    background: Theme.surface;
    accessible-role: button;
    accessible-label: info.name;
    accessible-description: info.description;
    accessible-action-default => { Tools.navigate(info.id); }
    HorizontalLayout {
        padding: 14px;
        padding-left: 16px;
        spacing: 14px;
        ToolChip { y: (parent.height - self.height) / 2; icon: root.info.icon; tint: root.info.tint; }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text { text: root.info.name; font-size: 15px; font-weight: 600; color: Theme.text; }
            Muted { text: root.info.description; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { Tools.navigate(root.info.id); } }
}

component CardGrid inherits Rectangle {
    in property <[ToolInfo]> tools;
    in property <bool> featured;
    property <int> columns: max(1, floor((self.width + 12px) / (215px + 12px)));
    property <[int]> indexes;
    property <length> card-width: (self.width - 12px * (columns - 1)) / columns;
    property <int> count: featured ? 4 : 8;
    height: ceil(count / columns) * 104px - 12px;
    for info[i] in tools: ToolCard {
        property <int> slot: featured ? i : i - 4;
        visible: info.featured == root.featured;
        x: mod(slot, root.columns) * (root.card-width + 12px);
        y: floor(slot / root.columns) * 104px;
        width: root.card-width;
        height: 92px;
        info: info;
    }
}

component Home inherits ScrollView {
    VerticalLayout {
        padding: 36px;
        padding-left: 28px;
        padding-right: 28px;
        spacing: 16px;
        alignment: start;
        VerticalLayout {
            spacing: 6px;
            Text { text: "PDF Tools"; font-size: 28px; font-weight: 650; color: Theme.text; }
            Text { text: "Everything runs on your computer — your files never leave it."; color: Theme.muted; }
        }
        CardGrid { tools: Tools.catalog; featured: true; }
        Rectangle {
            height: 54px;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;
            accessible-role: button;
            accessible-label: "Full tool catalog";
            accessible-expandable: true;
            accessible-expanded: Tools.catalog-open;
            accessible-action-default => { Tools.catalog-open = !Tools.catalog-open; }
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                Text { text: "FULL TOOL CATALOG"; color: Theme.catalog-red; font-size: 12.5px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; horizontal-stretch: 1; }
                Icon { y: (parent.height - self.height) / 2; icon: @image-url("icons/chevron-up.svg"); tint: Theme.catalog-red; transform-rotation: Tools.catalog-open ? 0deg : 180deg; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { Tools.catalog-open = !Tools.catalog-open; } }
        }
        if Tools.catalog-open: CardGrid { tools: Tools.catalog; featured: false; }
        Muted {
            text: "Made with Slint · slint.dev";
            horizontal-alignment: center;
        }
    }
}

component ViewerOverlay inherits Rectangle {
    background: #0a0c12db;
    accessible-role: groupbox;
    accessible-label: "Page viewer";
    TouchArea { clicked => { Viewer.close(); } }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { Viewer.close(); return accept; }
            if (event.text == Key.LeftArrow) { Viewer.step(-1); return accept; }
            if (event.text == Key.RightArrow) { Viewer.step(1); return accept; }
            if ((event.text == "r" || event.text == "R") && Viewer.can-rotate) { Viewer.rotate(event.modifiers.shift ? -90 : 90); return accept; }
            reject
        }
    }
    init => { focus.focus(); }

    property <length> avail-w: self.width - 160px;
    property <length> avail-h: self.height - 110px;
    property <bool> wide: Viewer.tile.aspect > avail-w / max(1px, avail-h);
    Rectangle {
        y: 32px;
        x: (parent.width - self.width) / 2;
        width: root.wide ? root.avail-w : root.avail-h * Viewer.tile.aspect;
        height: root.wide ? root.avail-w / Viewer.tile.aspect : root.avail-h;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000080;
        PageCanvas { tile: Viewer.tile; box-width: parent.width; box-height: parent.height; }
    }
    IconButton {
        x: 14px; y: (parent.height - self.height) / 2; size: 44px; tint: #ffffffcc;
        icon: @image-url("icons/chevron-left.svg"); label: "Previous page"; enabled: Viewer.can-prev;
        clicked => { Viewer.step(-1); }
    }
    IconButton {
        x: parent.width - self.width - 14px; y: (parent.height - self.height) / 2; size: 44px; tint: #ffffffcc;
        icon: @image-url("icons/chevron-right.svg"); label: "Next page"; enabled: Viewer.can-next;
        clicked => { Viewer.step(1); }
    }
    IconButton {
        x: parent.width - self.width - 12px; y: 12px; size: 44px; tint: #ffffffcc;
        icon: @image-url("icons/x.svg"); label: "Close"; clicked => { Viewer.close(); }
    }
    HorizontalLayout {
        y: parent.height - 50px;
        height: 40px;
        alignment: center;
        spacing: 4px;
        if Viewer.can-rotate: IconButton {
            size: 36px; tint: #ffffffcc; icon: @image-url("icons/rotate-ccw.svg"); label: "Rotate left";
            clicked => { Viewer.rotate(-90); }
        }
        if Viewer.can-rotate: IconButton {
            size: 36px; tint: #ffffffcc; icon: @image-url("icons/rotate-cw.svg"); label: "Rotate right";
            clicked => { Viewer.rotate(90); }
        }
        Text {
            accessible-role: text;
            accessible-label: "viewer caption";
            text: Viewer.caption;
            color: #ffffffcc;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "PDF Tools";
    icon: @image-url("icons/merge.svg");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 500px;
    background: Theme.bg;
    default-font-size: Theme.font;

    HorizontalLayout {
        Rectangle {
            width: 210px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 18px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 14px;
                Text { text: "PDF Tools"; font-size: 16px; font-weight: 700; color: Theme.text; x: 10px; }
                VerticalLayout {
                    spacing: 1px;
                    alignment: start;
                    NavItem { id: "home"; name: "All tools"; icon: @image-url("icons/home.svg"); tint: #8b93a7; }
                    Rectangle { height: 13px; Rectangle { height: 1px; background: Theme.border; x: 8px; width: parent.width - 16px; } }
                    for info in Tools.catalog: NavItem { id: info.id; name: info.name; icon: info.icon; tint: info.tint; }
                }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        }
        Rectangle {
            horizontal-stretch: 1;
            // Tool pages stay alive while hidden so their controls keep what
            // the user chose, matching the state kept on the Rust side.
            if Tools.active == "home": Home { }
            MergePage { visible: Tools.active == "merge"; }
            ToolPage { tool: 1; visible: Tools.active == "split"; }
            ToolPage { tool: 2; visible: Tools.active == "compress"; }
            ToolPage { tool: 3; visible: Tools.active == "protect"; }
            ToolPage { tool: 4; visible: Tools.active == "unlock"; }
            ToolPage { tool: 5; visible: Tools.active == "rotate"; }
            ToolPage { tool: 6; visible: Tools.active == "rearrange"; }
            ToolPage { tool: 7; visible: Tools.active == "page-numbers"; }
            ToolPage { tool: 8; visible: Tools.active == "watermark"; }
            ToolPage { tool: 9; visible: Tools.active == "metadata"; }
            SignaturePage { visible: Tools.active == "signature"; }
            ToolPage { tool: 11; visible: Tools.active == "grayscale"; }
        }
    }

    if Viewer.open: ViewerOverlay { }

    if Tools.dropping: Rectangle {
        background: Theme.accent.with-alpha(0.12);
        border-width: 3px;
        border-color: Theme.accent;
        Rectangle {
            width: drop-label.preferred-width + 44px;
            height: 48px;
            border-radius: Theme.radius;
            background: Theme.accent;
            drop-label := Text {
                text: Tools.active == "home" ? "Open a tool first, then drop files" : "Drop PDF files here";
                color: white;
                font-size: 16px;
                font-weight: 600;
            }
        }
    }
}
