load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//:version.bzl", "RUSTC_ENV", "VERSION")

APP_DEPS = [
    "//crates/pdftools-core:pdftools_core",
    "//crates/pdftools-render:pdftools_render",
] + all_crate_deps(normal = True)

# The icon and file details Windows shows for pdftools.exe (a no-op elsewhere).
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    # winresource also reads the manifest (for [package.metadata.winresource]).
    data = [
        "Cargo.toml",
        "//packaging:icon.ico",
    ],
    # winresource fills in the file details from Cargo's package variables.
    pkg_name = "pdftools-app",
    version = VERSION,
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "pdftools_app",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    compile_data = glob(["icons/*.svg"]) + ["//packaging:icon-256.png"],
    crate_root = "src/lib.rs",
    rustc_env = RUSTC_ENV,
    version = VERSION,
    deps = APP_DEPS,
)

rust_binary(
    name = "pdftools",
    srcs = ["src/main.rs"],
    rustc_env = RUSTC_ENV,
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = [
        ":build_script",
        ":pdftools_app",
    ] + APP_DEPS,
)

rust_test(
    name = "unit_tests",
    crate = ":pdftools_app",
    deps = all_crate_deps(normal_dev = True),
)

ACCEPTANCE_DATA = [
    "//crates/pdftools-core:sample_photos",
    "//tests/fixtures:encrypted",
    "//tests/fixtures:pdfjs",
]

rust_test(
    name = "acceptance",
    srcs = [
        "tests/acceptance.rs",
        "tests/common/mod.rs",
    ],
    crate_root = "tests/acceptance.rs",
    data = ACCEPTANCE_DATA,
    rustc_env = RUSTC_ENV,
    tags = ["manual"],
    version = VERSION,
    deps = [":pdftools_app"] + APP_DEPS + all_crate_deps(normal_dev = True),
)

# Full PDF workflows, run explicitly on pushes to main. Keeping it manual
# leaves normal `bazel test //...` fast and avoids tripling the work in the
# cross-platform unit-test matrix.
rust_test(
    name = "acceptance_main",
    srcs = [
        "tests/acceptance.rs",
        "tests/common/mod.rs",
    ],
    crate_features = ["ci_acceptance"],
    crate_root = "tests/acceptance.rs",
    data = ACCEPTANCE_DATA,
    rustc_env = RUSTC_ENV,
    tags = ["manual"],
    timeout = "long",
    version = VERSION,
    deps = [":pdftools_app"] + APP_DEPS + all_crate_deps(normal_dev = True),
)

# Screenshot capture and contact-sheet assembly must happen sequentially.
rust_test(
    name = "acceptance_visuals",
    srcs = [
        "tests/acceptance.rs",
        "tests/common/mod.rs",
    ],
    crate_features = ["visual_capture"],
    crate_root = "tests/acceptance.rs",
    data = ACCEPTANCE_DATA,
    rustc_env = RUSTC_ENV,
    tags = ["manual"],
    timeout = "long",
    version = VERSION,
    deps = [":pdftools_app"] + APP_DEPS + all_crate_deps(normal_dev = True),
)

rust_test(
    name = "ui",
    srcs = [
        "tests/ui.rs",
        "tests/common/mod.rs",
    ],
    crate_root = "tests/ui.rs",
    data = ACCEPTANCE_DATA,
    rustc_env = RUSTC_ENV,
    version = VERSION,
    deps = [":pdftools_app"] + APP_DEPS + all_crate_deps(normal_dev = True),
)

rust_binary(
    name = "render_icons",
    srcs = ["examples/render_icons.rs"],
    rustc_env = RUSTC_ENV,
    version = VERSION,
    deps = [":pdftools_app"] + APP_DEPS + all_crate_deps(normal_dev = True),
)

# The web version (//web) uses the same icons.
filegroup(
    name = "icons",
    srcs = glob(["icons/*.svg"]),
    visibility = ["//web:__pkg__"],
)
