load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test")
load("//:version.bzl", "RUSTC_ENV", "VERSION")

FFI_DEPS = [
    "//crates/pdftools-cli:pdftools_cli",
    "//crates/pdftools-core:pdftools_core",
    "//crates/pdftools-render:pdftools_render",
] + all_crate_deps(normal = True)

# The engine for the iOS app; ios/build-engine.sh builds it for the device and
# the simulator and packs it with include/ into an XCFramework.
rust_static_library(
    name = "pdftools_ffi",
    srcs = ["src/lib.rs"],
    rustc_env = RUSTC_ENV,
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = FFI_DEPS,
)

# The same crate as a Rust library, for its tests.
rust_library(
    name = "pdftools_ffi_lib",
    srcs = ["src/lib.rs"],
    crate_name = "pdftools_ffi",
    rustc_env = RUSTC_ENV,
    version = VERSION,
    deps = FFI_DEPS,
)

rust_test(
    name = "unit_tests",
    crate = ":pdftools_ffi_lib",
    data = ["//tests/fixtures:pdfjs"],
    deps = all_crate_deps(normal_dev = True),
)
