load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")

filegroup(
    name = "pdfjs",
    srcs = glob(["pdfjs/*.pdf"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "encrypted",
    srcs = glob(["encrypted/*.pdf"]),
    visibility = ["//visibility:public"],
)

# Inputs the fuzzers found crashes with, kept as regression tests.
filegroup(
    name = "fuzz",
    srcs = glob(["fuzz/*.pdf"]),
    visibility = ["//visibility:public"],
)

apple_resource_bundle(
    name = "ios_fixtures",
    bundle_name = "fixtures",
    structured_resources = glob(["pdfjs/*.pdf", "encrypted/*.pdf"]),
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
